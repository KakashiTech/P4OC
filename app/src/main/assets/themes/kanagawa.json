    "darkYellow": "#c0a36e",
    "darkBlue": "#7e9cd8",
    "darkPurple": "#938aa9",
    "darkAqua": "#6a9589",
    "darkOrange": "#dca561",
    "darkRedBright": "#e82424",
    "darkGreenBright": "#98bb6c",
    "darkYellowBright": "#e6c384",
    "darkBlueBright": "#7fb4ca",
    "darkPurpleBright": "#957fb8",
    "darkAquaBright": "#7aa89f",
    "darkOrangeBright": "#ffa066",
    "lightBg0": "#f2ecbc",

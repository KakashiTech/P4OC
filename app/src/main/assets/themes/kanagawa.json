    "syntaxVariable": { "dark": "darkBlueBright", "light": "lightBlue" },
    "syntaxString": { "dark": "darkYellowBright", "light": "lightYellow" },
    "syntaxNumber": { "dark": "darkOrangeBright", "light": "lightOrange" },
